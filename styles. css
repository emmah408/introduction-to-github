body {
  font-family: Arial, sans-serif;
  padding: 20px;
}
header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
main {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 20px;
}
.product {
  border: 1px solid #ccc;
  padding: 10px;
}
